# AYUR-INTEL Environment Configuration
# Copy this to .env and fill in values.
# NEVER commit .env with real secrets.

# =============================================================================
# DATABASE
# =============================================================================
# SQLite (default for development)
AYURINTEL_DB_PATH=data/ayur_intel.db

# PostgreSQL (for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/ayur_intel

# =============================================================================
# APPLICATION
# =============================================================================
AYURINTEL_HOST=127.0.0.1
AYURINTEL_PORT=8000
AYURINTEL_DEBUG=false

# =============================================================================
# AUTHENTICATION
# =============================================================================
# IMPORTANT: Change this to a strong random secret in production
AYURINTEL_SESSION_SECRET=change-me-in-production
AYURINTEL_SESSION_TTL_SECONDS=86400

# Set to false in production to require real authentication
AYURINTEL_DEMO_MODE=true

# =============================================================================
# CORS
# =============================================================================
# Comma-separated list of allowed origins
AYURINTEL_CORS_ALLOW_ORIGINS=http://127.0.0.1:8000

# For production with custom domain:
# AYURINTEL_CORS_ALLOW_ORIGINS=https://your-domain.com

# =============================================================================
# AI PROVIDER (Optional)
# =============================================================================
# AYURINTEL_AI_PROVIDER=none
# AYURINTEL_AI_API_KEY=your-api-key-here

# =============================================================================
# PLANT IDENTIFICATION (Optional — PlantNet)
# =============================================================================
# Enable real plant identification via PlantNet API
# Free tier: 500 identifications/day
# Sign up at: https://my.plantnet.org/
#
# Set provider to 'plantnet' to use real identification:
AYURINTEL_PLANT_ID_PROVIDER=unconfigured
#
# Your PlantNet API key (get from https://my.plantnet.org/account/settings):
AYURINTEL_PLANTNET_API_KEY=
#
# PlantNet project scope (default: 'all'):
# Options: 'all', 'weurope', 'canada', 'australia', etc.
AYURINTEL_PLANTNET_PROJECT=all

# =============================================================================
# EXTERNAL SOURCES (Optional)
# =============================================================================
# Patent sources
# AYURINTEL_EPO_API_KEY=
# AYURINTEL_USPTO_API_KEY=

# Regulatory sources
# AYURINTEL_REGULATORY_API_KEY=

# =============================================================================
# LOGGING
# =============================================================================
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# AYURINTEL_LOG_LEVEL=INFO

# =============================================================================
# RATE LIMITING
# =============================================================================
# AYURINTEL_RATE_LIMIT_REQUESTS=60
# AYURINTEL_RATE_LIMIT_WINDOW_SECONDS=60

# =============================================================================
# DEPLOYMENT
# =============================================================================
# Set to true behind a reverse proxy (nginx, etc.)
# AYURINTEL_BEHIND_PROXY=false

# SSL/HTTPS settings (if handling TLS directly)
# AYURINTEL_SSL_CERTFILE=
# AYURINTEL_SSL_KEYFILE=
